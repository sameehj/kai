{
  "manifest_version": 3,
  "name": "Kai",
  "short_name": "Kai",
  "version": "0.2.0",
  "description": "Checks what you send to AI chats for secrets and company data, using your local Kai policy.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Kai",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/kai-16.png", "32": "icons/kai-32.png" }
  },
  "icons": { "16": "icons/kai-16.png", "48": "icons/kai-48.png", "128": "icons/kai-128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://chat.mistral.ai/*",
        "https://grok.com/*",
        "https://poe.com/*",
        "file:///*/kai-browser-test.html"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
