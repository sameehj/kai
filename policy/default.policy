# Kai policy — this file controls what agents may read and what may leave
# the machine. Lines are "directive arguments". '#' starts a comment.
# Edit it, then run `kai doctor` to check it. Missing file = these defaults.

# ── Files agents may never read ──────────────────────────────────────
protect ~/.ssh
protect ~/.aws
protect ~/.config/gcloud
protect ~/.kube
protect ~/.docker/config.json
protect ~/.netrc
protect ~/.npmrc
protect ~/.pypirc
protect ~/.gnupg
protect ~/.kai                 # agents can't read or edit Kai's own config/log
protect .env
protect .env.*
protect *.pem
protect *.key
protect id_rsa
protect id_ed25519
allow   .env.example           # safe to share
allow   .env.sample

# ── Built-in secret detectors ────────────────────────────────────────
# action for anything the detectors below match: redact | block | warn | off
secrets redact

# ── Behaviour switches ───────────────────────────────────────────────
on_prompt_secret   block   # secret typed into a prompt: block | warn
on_file_secret     ask     # agent reads a file holding secrets or blocked terms: ask | block | warn
on_upload          block   # command that looks like it exfiltrates data: block | ask | warn
injection          warn    # prompt-injection text in a tool result: warn | off
max_scan_bytes     2000000

# ── Network wall (macOS network extension + gateway) ──────────────────
# Traffic from agent processes (Claude Code, Cursor, Codex, … and anything
# they start) to hosts not on the allowlist: off | log | block
# Model APIs, GitHub, the main package registries and this Mac (loopback)
# are built in. An entry is a host (with its subdomains), an IP address or
# CIDR range, optionally with :port. In block mode a connection with no host
# name (a raw socket to an IP, ssh to an IP) needs an address entry.
egress             log
# egress_allow  internal.example.com  db.example.com:5432
# egress_allow  10.0.0.0/8  203.0.113.5:22  [2001:db8::1]:22
# gateway_port  8787               # local AI gateway (kai gateway)
#
# Extra agents, matched by executable path, argument, or signing Team ID:
# agent  aider  arg  */bin/aider

# ── Storage wall (macOS Endpoint Security) ────────────────────────────
# Stops agent processes from opening protected files at all (not just
# through the hooks). off | log | block. Needs Apple's Endpoint Security
# entitlement, so it does nothing until that ships; leave off.
storage            off

# ── Company rules ─────────────────────────────────────────────────────
# term  <action> <text>          exact words, case-insensitive
# rule  <name> <action> <regex>  POSIX extended regex, case-insensitive
#   action: block | redact | warn | replace:"replacement text"
#
# Examples — uncomment and edit for your company:
# term  replace:"Project X"   Project Falcon
# term  block                 CONFIDENTIAL DO NOT DISTRIBUTE
# rule  internal_host redact  [a-z0-9-]+\.corp\.example\.com
# rule  cust_email    redact  [a-z0-9._%+-]+@bigcustomer\.com

# ── Upload / remote-code patterns (checked on shell commands) ─────────
# POSIX extended regex, case-insensitive. Avoid \b and \s (not portable to
# macOS BSD regex). Matched against each pipeline as Kai reads it: one line
# like "cat notes.txt | nc host 9000", command names without their path or
# sudo/env in front, heredoc bodies and comments left out. So "(^|\| )nc"
# means nc is run, not just mentioned.
rule_upload curl_upload    (^|\| )(curl|wget) .*(-d|--data|-T|--upload-file|-F).*@
rule_upload pipe_to_shell  (^|\| )(curl|wget) .*\| (sh|bash|zsh|python[0-9.]*)( |$)
rule_upload netcat         (^|\| )(nc|ncat|netcat)( |$)
rule_upload remote_scp     (^|\| )scp .*:

# ── Your exceptions ───────────────────────────────────────────────────
# exempt <rule> <glob over the whole command>: a check that wrongly blocked
# you. '*' and '?' match anything. Kai's own protection can't be exempted.
# The Activity page adds these for you ("Not a threat").
# exempt  netcat  python3 tests/*

# ── Activity log ──────────────────────────────────────────────────────
# Keep a redacted excerpt of what was blocked (the command, path or part of
# the prompt) so you can see why. Secrets in it are hidden. on | off
audit_context      on

# ── Prompt-injection patterns (checked on tool results) ───────────────
rule_injection ignore_prev   ignore (all |your |previous |prior )*instructions
rule_injection new_instr     (new|updated|system) (instructions|directive|prompt)[: ]
rule_injection exfil_ask     (send|upload|post|exfiltrate|leak).{0,40}(\.ssh|\.env|secret|credential|token|api[_ ]?key)
rule_injection override_role you are (now )?(a |an )?(different|new|dan|developer mode)
rule_injection disregard     (disregard|forget|override).{0,20}(instruction|rule|guardrail|policy)
