<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.sameehj.kai.control</string>
  <!-- The app itself hosts the listener; launchd launches it on demand and
       routes the Mach service to the instance that checks the listener in. -->
  <key>BundleProgram</key>
  <string>Contents/MacOS/Kai</string>
  <key>MachServices</key>
  <dict>
    <key>io.github.sameehj.kai.control</key>
    <true/>
  </dict>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>io.github.sameehj.kai</string>
  </array>
</dict>
</plist>
